<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C101B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Google TV Style Top Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="28dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="12dp">

            <!-- Left Navigation Menu (Search + Tabs) -->
            <LinearLayout
                android:id="@+id/top_nav_left"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.rock.screenshow.views.TVButton
                    android:id="@+id/searchBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/rounded_corner_background"
                    android:backgroundTint="#242B3D"
                    android:drawableStart="@drawable/search_24px"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/white"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Search"
                    android:textAllCaps="false"
                    android:textColor="#E0E3EA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tab_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Home"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tab_discover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Discover"
                    android:textColor="#8C93A8"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tab_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Apps"
                    android:textColor="#8C93A8"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Right Controls (Settings, Profile, Clock) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.rock.screenshow.views.TVButton
                    android:id="@+id/settings"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/rounded_corner_background"
                    android:backgroundTint="#242B3D"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Settings"
                    android:textAllCaps="false"
                    android:textColor="#E0E3EA"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_account_circle"
                    app:tint="#D0D5E2" />

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#8C93A8"
                    android:textSize="22sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Content Rows Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:id="@+id/parentLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                </LinearLayout>
            </ScrollView>

            <View
                android:id="@+id/topshadow"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@drawable/shadow_bottom"
                android:rotation="180"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Splash Screen Overlay -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/splash_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="zoom"
            app:show_buffering="never"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <ImageView
            android:id="@+id/loader"
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/loader"
            android:translationY="120dp" />
    </FrameLayout>
</FrameLayout>
